generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// USER MODEL - Complete with all security fields
model User {
  id                  String        @id @default(uuid())
  supabase_uid        String?       @unique @map("supabase_uid")
  firstName           String        @map("first_name")
  lastName            String        @map("last_name")
  email               String        @unique
  password_hash       String
  company             String
  designation         String
  profileImage        String?       @map("profile_image")
  bio                 String?
  role                Role          @default(CANDIDATE)
  is_verified         Boolean       @default(false) @map("is_verified")
  is_active           Boolean       @default(true) @map("is_active")
  is_locked           Boolean       @default(false) @map("is_locked")
  lock_reason         String?       @map("lock_reason")
  locked_until        DateTime?     @map("locked_until")
  last_login_at       DateTime?     @map("last_login_at")
  login_attempts      Int           @default(0) @map("login_attempts")
  last_failed_login   DateTime?     @map("last_failed_login")
  password_changed_at DateTime?     @map("password_changed_at")
  invited_by          String?       @map("invited_by")
  invited_at          DateTime?     @map("invited_at")
  created_at          DateTime      @default(now()) @map("created_at")
  updated_at          DateTime      @updatedAt @map("updated_at")
  
  // Payment fields ★ v3.0
  payment_status      PaymentStatus @default(UNPAID) @map("payment_status")
  paid_at             DateTime?     @map("paid_at")
  phone               String?       // Required for PayHere checkout
  address             String?       // Required for PayHere checkout
  
  applications        Application[]
  emailTokens         EmailToken[]
  auditLogs           AuditLog[]
  payments            Payment[]

  @@index([email])
  @@map("users")
}

enum Role {
  CANDIDATE
  ADMIN
  JUDGE
}

enum PaymentStatus {
  UNPAID    // User has not started payment yet (default)
  PENDING   // Payment initiated — waiting for PayHere webhook
  PAID      // Confirmed by PayHere — terminal state
  FAILED    // PayHere returned -2 (card declined / error)
  CANCELLED // User cancelled on PayHere page (status_code = -1)
  EXPIRED   // No webhook received within 24 hours
  REFUNDED  // Admin issued refund
}

// PAYMENT MODEL ★ v3.0
model Payment {
  id                    String        @id @default(uuid())
  user_id               String        @map("user_id")
  user                  User          @relation(fields: [user_id], references: [id])
  
  // PayHere tracking
  order_id              String        @unique @map("order_id")
  payhere_payment_id    String?       @unique @map("payhere_payment_id")
  
  // Payment details
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("LKR")
  status                PaymentStatus @default(PENDING)
  
  // PayHere response
  payhere_status_code   Int?          @map("payhere_status_code")
  payhere_status_message String?      @map("payhere_status_message")
  payhere_method        String?       @map("payhere_method")
  payhere_hash          String?       @map("payhere_hash")
  
  // Idempotency
  webhook_received_at   DateTime?     @map("webhook_received_at")
  webhook_processed     Boolean       @default(false) @map("webhook_processed")
  
  // Retry tracking
  retry_count           Int           @default(0) @map("retry_count")
  max_retries           Int           @default(3) @map("max_retries")
  parent_order_id       String?       @map("parent_order_id")
  expired_at            DateTime?     @map("expired_at")
  
  // Security & Metadata
  ip_address            String?       @map("ip_address")
  created_at            DateTime      @default(now()) @map("created_at")
  updated_at            DateTime      @updatedAt @map("updated_at")
  paid_at               DateTime?     @map("paid_at")

  // Relations
  logs                  PaymentLog[]

  @@index([user_id])
  @@index([order_id])
  @@index([status])
  @@map("payments")
}

// PAYMENT LOG MODEL ★ v3.0
model PaymentLog {
  id              String   @id @default(uuid())
  payment_id      String?  @map("payment_id")
  payment         Payment? @relation(fields: [payment_id], references: [id])
  order_id        String   @map("order_id")
  
  // Event
  event_type      String   @map("event_type") // INITIATE, WEBHOOK_VERIFIED, WEBHOOK_REJECTED, etc.
  
  // Raw gateway data
  
  gateway_payload Json?    @map("gateway_payload")
  gateway_status  String?  @map("gateway_status")
  gateway_method  String?  @map("gateway_method")
  gateway_amount  String?  @map("gateway_amount")
  
  // Context
  ip_address      String?  @map("ip_address")
  hash_valid      Boolean? @map("hash_valid")
  processed       Boolean  @default(false) @map("processed")
  notes           String?
  created_at      DateTime @default(now()) @map("created_at")

  @@index([order_id])
  @@index([event_type])
  @@map("payment_logs")
}

// EMAIL TOKEN MODEL
model EmailToken {
  id         String    @id @default(uuid())
  user_id    String    @map("user_id")
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token      String    @unique @default(uuid())
  type       TokenType
  expires_at DateTime  @map("expires_at")
  used_at    DateTime? @map("used_at")
  attempts   Int       @default(0) @map("attempts") // incremented on each wrong guess
  created_at DateTime  @default(now()) @map("created_at")

  @@index([user_id])
  @@index([token])
  @@index([expires_at])
  @@map("email_tokens")
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  INVITE
}

// AUDIT LOG MODEL
model AuditLog {
  id          String   @id @default(uuid())
  user_id     String?  @map("user_id")
  user        User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  action      String
  entity_type String?  @map("entity_type")
  entity_id   String?  @map("entity_id")
  ip_address  String?  @map("ip_address")
  user_agent  String?  @map("user_agent")
  metadata    Json?
  created_at  DateTime @default(now()) @map("created_at")

  @@index([user_id])
  @@index([action])
  @@index([created_at])
  @@map("audit_logs")
}

enum ApplicationType {
  INDIVIDUAL
  TEAM_COMPANY
}

enum ApplicationStatus {
  DRAFT // Candidate saving progress
  SUBMITTED // Candidate locked & submitted — no further edits
  UNDER_REVIEW // Judge assigned
  SHORTLISTED // Passed first review
  AWARDED // Winner — terminal state
  REJECTED // Did not progress — terminal state
}

enum CompanySize {
  SIZE_1_50
  SIZE_51_200
  SIZE_201_500
  SIZE_501_1000
  SIZE_1001_5000
  SIZE_5000_PLUS
}

enum ContactType {
  CEO
  HR_HEAD
  PRIMARY
  SECONDARY
}

enum FileType {
  VIDEO
  DOCUMENT
}

model AwardCategory {
  id            String          @id @default(uuid())
  name          String          @unique
  description   String?
  app_type      ApplicationType
  is_active     Boolean         @default(true) @map("is_active")
  display_order Int             @default(0) @map("display_order")
  created_at    DateTime        @default(now()) @map("created_at")
  updated_at    DateTime        @updatedAt @map("updated_at")
  applications  Application[]

  @@index([app_type])
  @@index([is_active])
  @@map("award_categories")
}

model Application {
  id                String               @id @default(uuid())
  // Ownership
  user_id           String               @unique @map("user_id")
  user              User                 @relation(fields: [user_id], references: [id])
  // Section 1
  application_type  ApplicationType      @map("application_type")
  experience_years  Int?                 @map("experience_years") // INDIVIDUAL only
  // Section 2 — Company / Organisation
  company_name      String               @map("company_name")
  founded_year      Int?                 @map("founded_year")
  company_email     String               @map("company_email")
  company_phone     String               @map("company_phone")
  company_size      CompanySize?         @map("company_size")
  company_website   String?              @map("company_website")
  linkedin_profile  String?              @map("linkedin_profile")
  company_address   String?              @map("company_address")
  // Section 3 — Award Category
  category_id       String               @map("category_id")
  category          AwardCategory        @relation(fields: [category_id], references: [id])
  // Declaration
  declaration_agreed Boolean              @default(false) @map("declaration_agreed")
  // Lifecycle
  status            ApplicationStatus    @default(DRAFT) @map("status")
  submitted_at      DateTime?            @map("submitted_at")
  reviewed_by       String?              @map("reviewed_by")
  reviewer_notes    String?              @map("reviewer_notes")
  status_changed_at DateTime?            @map("status_changed_at")
  created_at        DateTime             @default(now()) @map("created_at")
  updated_at        DateTime             @updatedAt @map("updated_at")
  contacts          ApplicationContact[]
  files             ApplicationFile[]

  @@index([status])
  @@index([category_id])
  @@map("applications")
}

model ApplicationContact {
  id             String      @id @default(uuid())
  application_id String      @map("application_id")
  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
  contact_type   ContactType @map("contact_type")
  full_name      String      @map("full_name")
  designation    String
  email          String
  phone          String
  created_at     DateTime    @default(now()) @map("created_at")
  updated_at     DateTime    @updatedAt @map("updated_at")

  @@unique([application_id, contact_type])
  @@map("application_contacts")
}

model ApplicationFile {
  id             String      @id @default(uuid())
  application_id String      @map("application_id")
  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
  file_type      FileType    @map("file_type")
  storage_path   String      @map("storage_path") // Supabase bucket path
  original_name  String      @map("original_name")
  mime_type      String      @map("mime_type")
  size_bytes     BigInt      @map("size_bytes")
  created_at     DateTime    @default(now()) @map("created_at")

  @@index([application_id])
  @@index([file_type])
  @@map("application_files")
}

