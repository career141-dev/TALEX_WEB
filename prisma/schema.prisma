generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// USER MODEL - Complete with all security fields
model User {
  id                  String        @id @default(uuid())
  supabase_uid        String?       @unique @map("supabase_uid")
  firstName           String        @map("first_name")
  lastName            String        @map("last_name")
  email               String        @unique
  password_hash       String
  company             String
  designation         String
  phone               String?
  profileImage        String?       @map("profile_image")
  bio                 String?
  role                Role          @default(CANDIDATE)
  is_verified         Boolean       @default(false) @map("is_verified")
  is_active           Boolean       @default(true) @map("is_active")
  is_locked           Boolean       @default(false) @map("is_locked")
  lock_reason         String?       @map("lock_reason")
  locked_until        DateTime?     @map("locked_until")
  last_login_at       DateTime?     @map("last_login_at")
  login_attempts      Int           @default(0) @map("login_attempts")
  last_failed_login   DateTime?     @map("last_failed_login")
  password_changed_at DateTime?     @map("password_changed_at")
  invited_by          String?       @map("invited_by")
  invited_at          DateTime?     @map("invited_at")
  created_at          DateTime      @default(now()) @map("created_at")
  updated_at          DateTime      @updatedAt @map("updated_at")
  applications        Application[]
  emailTokens         EmailToken[]
  auditLogs           AuditLog[]

  @@index([email])
  @@map("users")
}

enum Role {
  CANDIDATE
  ADMIN
  JUDGE
}

// EMAIL TOKEN MODEL
model EmailToken {
  id         String    @id @default(uuid())
  user_id    String    @map("user_id")
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token      String    @unique @default(uuid())
  type       TokenType
  expires_at DateTime  @map("expires_at")
  used_at    DateTime? @map("used_at")
  attempts   Int       @default(0) @map("attempts") // incremented on each wrong guess
  created_at DateTime  @default(now()) @map("created_at")

  @@index([user_id])
  @@index([token])
  @@index([expires_at])
  @@map("email_tokens")
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  INVITE
}

// AUDIT LOG MODEL
model AuditLog {
  id          String   @id @default(uuid())
  user_id     String?  @map("user_id")
  user        User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  action      String
  entity_type String?  @map("entity_type")
  entity_id   String?  @map("entity_id")
  ip_address  String?  @map("ip_address")
  user_agent  String?  @map("user_agent")
  metadata    Json?
  created_at  DateTime @default(now()) @map("created_at")

  @@index([user_id])
  @@index([action])
  @@index([created_at])
  @@map("audit_logs")
}

model Application {
  id          String   @id @default(uuid())
  title       String
  description String
  status      String   @default("pending")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id])

  @@map("applications")
}

