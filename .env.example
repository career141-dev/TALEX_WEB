PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# DATABASE (Prisma)
DATABASE_URL=postgresql://user:password@host:port/postgres?pgbouncer=true

# SUPABASE (Auth & Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# AUTH (JWT fallback)
JWT_SECRET=your-32-character-secret
JWT_REFRESH_SECRET=your-refresh-secret

# REDIS (Upstash - Rate Limiting)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# EMAIL (Brevo)
BREVO_API_KEY=your-api-key
FROM_EMAIL=noreply@example.com
FROM_NAME=Talex Awards

# PAYHERE PAYMENT GATEWAY
PAYHERE_MERCHANT_ID=your-id
PAYHERE_MERCHANT_SECRET=your-secret
PAYHERE_SANDBOX=true
PAYHERE_NOTIFY_URL=https://your-ngrok-url/api/payment/webhook
PAYHERE_RETURN_URL=http://localhost:3000/payment/return
PAYHERE_CANCEL_URL=http://localhost:3000/payment/cancel
PAYMENT_AMOUNT=5000
PAYMENT_CURRENCY=LKR
